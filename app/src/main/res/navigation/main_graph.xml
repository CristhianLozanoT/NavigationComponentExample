<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main_graph"
    app:startDestination="@id/firstFragment">

    <fragment
        android:id="@+id/firstFragment"
        android:name="com.example.navigationcomponentexample.view.FirstFragment"
        android:label="fragment_first"
        tools:layout="@layout/fragment_first" >
        <action
            android:id="@+id/action_firstFragment_to_secondFragment"
            app:destination="@id/secondFragment"
            app:enterAnim="@anim/nav_default_pop_enter_anim"
            app:exitAnim="@anim/nav_default_pop_exit_anim" />
    </fragment>
    <fragment
        android:id="@+id/secondFragment"
        android:name="com.example.navigationcomponentexample.view.SecondFragment"
        android:label="fragment_second"
        tools:layout="@layout/fragment_second" >
        <action
            android:id="@+id/action_secondFragment_to_thirdFragment"
            app:destination="@id/thirdFragment" />
        <argument
            android:name="name"
            app:argType="string"
            android:defaultValue="Guest" />
        <action
            android:id="@+id/action_secondFragment_to_camaraFragment"
            app:destination="@id/camaraFragment" />
        <action
            android:id="@+id/action_secondFragment_to_userListFragment"
            app:destination="@id/userListFragment" />
        <action
            android:id="@+id/action_secondFragment_to_userCrudFragment"
            app:destination="@id/userCrudFragment" />
    </fragment>
    <fragment
        android:id="@+id/thirdFragment"
        android:name="com.example.navigationcomponentexample.view.ThirdFragment"
        android:label="fragment_third"
        tools:layout="@layout/fragment_third" >
        <action
            android:id="@+id/action_thirdFragment_to_listaGrabacionesFragment"
            app:destination="@id/listaGrabacionesFragment" />
    </fragment>
    <fragment
        android:id="@+id/listaGrabacionesFragment"
        android:name="com.example.navigationcomponentexample.view.ListaGrabacionesFragment"
        android:label="ListaGrabacionesFragment" />
    <fragment
        android:id="@+id/camaraFragment"
        android:name="com.example.navigationcomponentexample.view.CamaraFragment"
        android:label="fragment_camara"
        tools:layout="@layout/fragment_camara" >
        <action
            android:id="@+id/action_camaraFragment_to_photoPreviewFragment"
            app:destination="@id/photoPreviewFragment" />
    </fragment>

    <fragment
        android:id="@+id/photoPreviewFragment"
        android:name="com.example.navigationcomponentexample.view.PhotoPreviewFragment"
        android:label="fragment_photo_preview"
        tools:layout="@layout/fragment_photo_preview" >
        <argument
            android:name="photoUri"
            app:argType="string" />
    </fragment>
    <fragment
        android:id="@+id/userListFragment"
        android:name="com.example.navigationcomponentexample.view.UserListFragment"
        android:label="fragment_user_list"
        tools:layout="@layout/fragment_user_list" />
    <fragment
        android:id="@+id/userCrudFragment"
        android:name="com.example.navigationcomponentexample.view.UserCrudFragment"
        android:label="UserCrudFragment" />


</navigation>